# ====================================================================
# FST Pay — Environment Template
# Copy this file to .env and fill in the values for your environment.
# ====================================================================

# Spring Active Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fstpay_app
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# Email SMTP (Gmail App Password or Resend)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
EMAIL_PROVIDER=smtp

# Google AI / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PROJECT_NUMBER=your_project_number_here
GOOGLE_PROJECT_NAME=your_project_name_here
AI_PROVIDER=gemini

# JWT Secret (Base64 encoded 256-bit key)
JWT_SECRET=your_jwt_secret_key_here

# Admin Initialization
ADMIN_EMAIL=admin@fstpay.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_FULLNAME=Administrator

# CORS & Client
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
