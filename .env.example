# =============================================================================
# FST Pay - Environment Variables
# Copy this file to .env, fill in real values, and NEVER commit .env
# =============================================================================

# --- REQUIRED: Database ---
POSTGRES_PASSWORD=changeme_secure_random_32_chars
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/fstpay
# SPRING_DATASOURCE_USERNAME=fstpay

# --- REQUIRED: JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=

# --- REQUIRED: CORS ---
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email Provider ---
# Options: smtp (default, for Mailtrap/dev) or resend (production)
EMAIL_PROVIDER=smtp
# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Sender address
EMAIL_FROM=FST Pay <no-reply@fstpay.com>

# --- SMTP (when EMAIL_PROVIDER=smtp) ---
# For development: use Mailtrap (https://mailtrap.io)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Admin seeding (first-run only) ---
ADMIN_EMAIL=admin@fstpay.com
ADMIN_PASSWORD=Admin@Secure123
ADMIN_FULLNAME=Administrator

# --- AI Coach ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- reCAPTCHA ---
RECAPTCHA_SECRET_KEY=

# --- Redis ---
# SPRING_REDIS_HOST=localhost
# SPRING_REDIS_PORT=6380
REDIS_PASSWORD=

# --- Logging ---
# Options: INFO, WARN, DEBUG
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_URL=http://localhost:8080/api/v1
VITE_RECAPTCHA_SITE_KEY=
