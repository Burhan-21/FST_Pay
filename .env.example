# =============================================================================
# FST Pay - Master Environment Variable Reference Template (.env.example)
# Copy to .env and configure real values. DO NOT commit production .env files.
# =============================================================================

# --- Core Platform Settings ---
SPRING_PROFILES_ACTIVE=prod
PORT=8080
LOG_LEVEL=INFO

# --- REQUIRED: Database Configuration ---
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_MIN_16_CHARS
SPRING_DATASOURCE_URL=jdbc:postgresql://fstpay-postgres:5432/fstpay
SPRING_DATASOURCE_USERNAME=fstpay
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_IN_PRODUCTION_MIN_16_CHARS

# --- REQUIRED: JWT Authentication ---
# Minimum 32 characters required in non-dev profiles. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_GENERATE_VIA_OPENSSL

# --- REQUIRED: Security & CORS ---
# Comma-separated allowed origins (no trailing slashes, no wildcard * in prod)
CORS_ALLOWED_ORIGINS=https://fstpay.com,https://app.fstpay.com

# --- REQUIRED: Redis Cache & Session Store ---
SPRING_REDIS_HOST=fstpay-redis
SPRING_REDIS_PORT=6379
REDIS_PASSWORD=

# --- Messaging & Event Streaming (Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=fstpay-kafka:9092
KAFKA_CONSUMER_GROUP_ID=fstpay-group

# --- Email Notifications ---
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=FST Pay <no-reply@fstpay.com>
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Admin Account Initial Seeding ---
ADMIN_EMAIL=admin@fstpay.com
ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
ADMIN_FULLNAME=Administrator

# --- AI Financial Advisor Service ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anti-Bot Protection ---
RECAPTCHA_SECRET_KEY=

# --- Frontend Application ---
VITE_API_URL=http://localhost:8080/api/v1
VITE_RECAPTCHA_SITE_KEY=
